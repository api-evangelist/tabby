{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/tabby/main/json-schema/tabby-dispute-schema.json",
  "title": "TabbyDispute",
  "description": "Tabby dispute object returned by the Disputes API.",
  "type": "object",
  "required": ["id", "status", "payment_id"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "payment_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": ["new", "approved", "challenged", "resolved", "rejected"]
    },
    "amount": { "type": "string" },
    "currency": { "type": "string", "enum": ["AED", "SAR", "KWD"] },
    "reason": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "deadline_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" },
          "attachment_id": { "type": "string" }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "content_type": { "type": "string", "enum": ["image/png", "image/jpeg", "application/pdf"] },
          "size": { "type": "integer", "maximum": 5242880, "description": "Max 5MB." }
        }
      }
    }
  }
}
